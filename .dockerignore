# Never bake credentials into the image.
.env
.env.*
!.env.example

# Generated data — the container regenerates from the seeded generator
# on first run. This keeps the image reproducible independent of host state.
data/*.csv
data/*.json

# Local scratch that shouldn't influence the build.
.git/
.gitignore
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/
.vscode/
.idea/
.DS_Store
Dockerfile
docker-compose.yml
.dockerignore
